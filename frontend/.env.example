# Copy to frontend/.env.local (git-ignored) and fill in.
# Local values come from `supabase status` (run in the repo root).
# Only PUBLIC values go here. Never put the secret / service-role key in the frontend.

# Local Supabase API (this project uses port 55421, see supabase/config.toml)
VITE_SUPABASE_URL=http://127.0.0.1:55421

# "Publishable" key (sb_publishable_...) from `supabase status`
VITE_SUPABASE_PUBLISHABLE_KEY=

# Cloudflare Turnstile site key (public). Local: Cloudflare's always-pass *test* key below
# (matches the test secret in supabase/config.toml). Production: the real site key.
VITE_TURNSTILE_SITE_KEY=1x00000000000000000000BB

# Show "Link Google" / "Sign in with Google" once a Google OAuth client is configured
# (see [auth.external.google] in supabase/config.toml).
VITE_GOOGLE_LINKING=false
